# Self-hosted Supabase (see /opt/supabase/docker/.env on the VPS for the instance itself)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.xerovolt.in
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (via Prisma) — pooled for app queries, direct for migrations
DATABASE_URL=
DIRECT_URL=

# PhonePe payment gateway
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_CALLBACK_URL=https://xerovolt.in/api/payment/phonepe/callback

# --- One-time Firebase migration only (scripts/migrate-firebase/*.js), not used by the app ---
# FIREBASE_PROJECT_ID=cube-8c773
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Optional — preserves existing user passwords instead of forcing a reset email.
# From Console -> Authentication -> Users -> export dialog -> "Password hash parameters".
# FIREBASE_SCRYPT_SIGNER_KEY=
# FIREBASE_SCRYPT_SALT_SEPARATOR=
# FIREBASE_SCRYPT_ROUNDS=
# FIREBASE_SCRYPT_MEM_COST=
